<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>W3UltrawideFix</AssemblyName>
    <RootNamespace>W3UltrawideFix</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Witcher 3 Remastered Ultrawide Cutscene Fix</Product>
    <Description>Removes cutscene black bars in The Witcher 3 Remastered on ultrawide monitors</Description>
    <Authors>shatulsky</Authors>
    <Copyright>Copyright (c) 2026 shatulsky</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
